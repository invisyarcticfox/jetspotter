  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  }
}
