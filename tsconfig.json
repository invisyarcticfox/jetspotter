{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": { "~/*": [ "./src/*" ] },
    "types": [ "node" ]
  },
  "include": [ "src" ],
  "exclude": [ "node_modules", "data" ]
}
